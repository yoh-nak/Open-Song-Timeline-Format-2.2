{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yoh-nak/Open-Song-Timeline-Format-2.2/schema/ostf-2.2.schema.json",
  "title": "Open Song Timeline Format (OSTF) 2.2.0",
  "description": "OSTF 2.2.0 song interchange schema. Validate semantic constraints using the reference validators; schema validity alone is insufficient.",
  "type": "object",
  "required": [
    "format",
    "version",
    "ppq",
    "song",
    "timeline",
    "harmony",
    "melodies",
    "lyrics"
  ],
  "properties": {
    "format": {
      "const": "OSTF"
    },
    "version": {
      "const": "2.2.0"
    },
    "ppq": {
      "const": 960
    },
    "song": {
      "type": "object",
      "required": [],
      "properties": {
        "title": {
          "type": "string"
        },
        "artist": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "scaleMeaning": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "original",
            "status"
          ],
          "properties": {
            "original": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "recognized",
                "unknown",
                "ambiguous",
                "unresolved"
              ]
            },
            "sourceDialect": {
              "type": "string"
            },
            "scaleId": {
              "type": "string",
              "pattern": "^scale\\.[a-z][a-z0-9-]*$"
            },
            "tonic": {
              "type": "string",
              "pattern": "^[A-G](?:#|b){0,2}$"
            },
            "tuningId": {
              "type": "string"
            },
            "intervals": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 11
              },
              "minItems": 1,
              "maxItems": 12,
              "uniqueItems": true
            },
            "pitchClasses": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 11
              },
              "minItems": 1,
              "maxItems": 12,
              "uniqueItems": true
            },
            "displaySpellings": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "maxItems": 12
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "const": "recognized"
                  }
                }
              },
              "then": {
                "required": [
                  "scaleId",
                  "tonic",
                  "intervals"
                ],
                "properties": {
                  "tuningId": {
                    "const": "12-TET"
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "unknown",
                      "ambiguous",
                      "unresolved"
                    ]
                  }
                }
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "scaleId"
                      ]
                    },
                    {
                      "required": [
                        "intervals"
                      ]
                    },
                    {
                      "required": [
                        "pitchClasses"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "timeline": {
      "type": "object",
      "required": [
        "sections",
        "meterChanges",
        "tempoChanges"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "start",
              "duration"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "duration": {
                "type": "integer",
                "minimum": 1
              },
              "name": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "intro",
                  "verse",
                  "preChorus",
                  "chorus",
                  "postChorus",
                  "bridge",
                  "breakdown",
                  "drop",
                  "solo",
                  "interlude",
                  "outro",
                  "other"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "meterChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "at",
              "numerator",
              "denominator"
            ],
            "properties": {
              "at": {
                "type": "integer",
                "minimum": 0
              },
              "numerator": {
                "type": "integer",
                "minimum": 1
              },
              "denominator": {
                "type": "integer",
                "enum": [
                  1,
                  2,
                  4,
                  8,
                  16,
                  32,
                  64
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "tempoChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "at",
              "bpm"
            ],
            "properties": {
              "at": {
                "type": "integer",
                "minimum": 0
              },
              "bpm": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": true
          }
        },
        "tonalChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "at",
              "root",
              "mode"
            ],
            "properties": {
              "at": {
                "type": "integer",
                "minimum": 0
              },
              "root": {
                "type": "string",
                "pattern": "^[A-G](?:#|b)?$"
              },
              "mode": {
                "type": "string",
                "minLength": 1
              },
              "scale": {
                "type": "string",
                "minLength": 1
              },
              "spelling": {
                "enum": [
                  "sharps",
                  "flats",
                  "contextual"
                ]
              },
              "scaleMeaning": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "original",
                  "status"
                ],
                "properties": {
                  "original": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "enum": [
                      "recognized",
                      "unknown",
                      "ambiguous",
                      "unresolved"
                    ]
                  },
                  "sourceDialect": {
                    "type": "string"
                  },
                  "scaleId": {
                    "type": "string",
                    "pattern": "^scale\\.[a-z][a-z0-9-]*$"
                  },
                  "tonic": {
                    "type": "string",
                    "pattern": "^[A-G](?:#|b){0,2}$"
                  },
                  "tuningId": {
                    "type": "string"
                  },
                  "intervals": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 11
                    },
                    "minItems": 1,
                    "maxItems": 12,
                    "uniqueItems": true
                  },
                  "pitchClasses": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 11
                    },
                    "minItems": 1,
                    "maxItems": 12,
                    "uniqueItems": true
                  },
                  "displaySpellings": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "maxItems": 12
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "const": "recognized"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "scaleId",
                        "tonic",
                        "intervals"
                      ],
                      "properties": {
                        "tuningId": {
                          "const": "12-TET"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "enum": [
                            "unknown",
                            "ambiguous",
                            "unresolved"
                          ]
                        }
                      }
                    },
                    "then": {
                      "not": {
                        "anyOf": [
                          {
                            "required": [
                              "scaleId"
                            ]
                          },
                          {
                            "required": [
                              "intervals"
                            ]
                          },
                          {
                            "required": [
                              "pitchClasses"
                            ]
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "harmony": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "start",
          "duration",
          "symbol"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "duration": {
            "type": "integer",
            "minimum": 1
          },
          "symbol": {
            "type": "string"
          },
          "noteProfile": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            }
          },
          "chordMeaning": {
            "title": "OSTF 2.1 proposed chord meaning object (standalone draft)",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "recognized",
                  "ambiguous",
                  "unknown",
                  "noChord",
                  "unresolved"
                ]
              },
              "root": {
                "type": "string",
                "pattern": "^[A-G](?:b|#){0,2}$"
              },
              "quality": {
                "enum": [
                  "major",
                  "minor",
                  "diminished",
                  "augmented",
                  "unspecified"
                ]
              },
              "seventh": {
                "enum": [
                  "none",
                  "minor",
                  "major",
                  "diminished"
                ]
              },
              "bass": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[A-G](?:b|#){0,2}$"
              },
              "extensions": {
                "type": "array",
                "items": {
                  "enum": [
                    9,
                    11,
                    13
                  ]
                },
                "uniqueItems": true
              },
              "alterations": {
                "type": "array",
                "items": {
                  "enum": [
                    "b5",
                    "#5",
                    "b9",
                    "#9",
                    "#11",
                    "b13",
                    "#13"
                  ]
                },
                "uniqueItems": true
              },
              "adds": {
                "type": "array",
                "items": {
                  "enum": [
                    2,
                    4,
                    6,
                    9,
                    11,
                    13
                  ]
                },
                "uniqueItems": true
              },
              "omissions": {
                "type": "array",
                "items": {
                  "enum": [
                    1,
                    3,
                    5,
                    7,
                    9,
                    11,
                    13
                  ]
                },
                "uniqueItems": true
              },
              "suspension": {
                "type": [
                  "integer",
                  "null"
                ],
                "enum": [
                  null,
                  2,
                  4
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "recognized"
                    }
                  }
                },
                "then": {
                  "required": [
                    "root",
                    "quality",
                    "seventh"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "unknown",
                        "ambiguous",
                        "noChord",
                        "unresolved"
                      ]
                    }
                  }
                },
                "then": {
                  "not": {
                    "required": [
                      "quality"
                    ]
                  }
                }
              }
            ]
          },
          "chordNotation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input",
              "interpretation",
              "rendering"
            ],
            "properties": {
              "input": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "dialect": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locale": {
                    "type": "string",
                    "minLength": 2
                  }
                }
              },
              "interpretation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "recognized",
                      "ambiguous",
                      "unknown",
                      "unresolved",
                      "noChord"
                    ]
                  },
                  "canonical": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ruleSet": {
                    "const": "ostf-chord-notation-2.2-d1"
                  },
                  "alternatives": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 2,
                    "uniqueItems": true
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "recognized"
                        }
                      },
                      "required": [
                        "status"
                      ]
                    },
                    "then": {
                      "required": [
                        "canonical",
                        "ruleSet"
                      ]
                    },
                    "else": {
                      "not": {
                        "required": [
                          "canonical"
                        ]
                      }
                    }
                  }
                ]
              },
              "rendering": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "style"
                ],
                "properties": {
                  "style": {
                    "enum": [
                      "original",
                      "standard",
                      "jazz",
                      "compact"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "polychord": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "composition",
                  "upper",
                  "lower"
                ],
                "properties": {
                  "composition": {
                    "const": "upper-over-lower"
                  },
                  "upper": {
                    "type": "string",
                    "minLength": 1
                  },
                  "lower": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "polychord"
                  ]
                },
                "then": {
                  "properties": {
                    "interpretation": {
                      "properties": {
                        "status": {
                          "const": "recognized"
                        }
                      },
                      "required": [
                        "status"
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "melodies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "vocal-main",
              "vocal-other",
              "instrumental"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "start",
                "duration",
                "pitch"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "duration": {
                  "type": "integer",
                  "minimum": 1
                },
                "pitch": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 127
                }
              },
              "additionalProperties": true
            }
          },
          "clips": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "start",
                "duration",
                "noteIds"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "duration": {
                  "type": "integer",
                  "minimum": 1
                },
                "noteIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "lyrics": {
      "type": "object",
      "required": [
        "documents",
        "phrases",
        "units",
        "alignments"
      ],
      "properties": {
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string"
              },
              "vocalText": {
                "type": "string"
              },
              "segments": {
                "type": "array",
                "items": {
                  "additionalProperties": false,
                  "title": "Lyric segment fragment",
                  "type": "object",
                  "properties": {
                    "source": {
                      "enum": [
                        "text",
                        "vocalText"
                      ]
                    },
                    "kind": {
                      "enum": [
                        "word",
                        "morpheme",
                        "syllable",
                        "mora",
                        "phrase",
                        "punctuation",
                        "other"
                      ]
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "source",
                    "kind",
                    "start",
                    "end"
                  ]
                }
              }
            },
            "additionalProperties": true
          }
        },
        "phrases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "documentId",
              "startOffset",
              "endOffset"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "documentId": {
                "type": "string",
                "minLength": 1
              },
              "startOffset": {
                "type": "integer",
                "minimum": 0
              },
              "endOffset": {
                "type": "integer",
                "minimum": 0
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "duration": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": true
          }
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "phraseId",
              "startOffset",
              "endOffset",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "phraseId": {
                "type": "string",
                "minLength": 1
              },
              "startOffset": {
                "type": "integer",
                "minimum": 0
              },
              "endOffset": {
                "type": "integer",
                "minimum": 0
              },
              "text": {
                "type": "string"
              },
              "reading": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "alignments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "unitId",
              "noteIds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "unitId": {
                "type": "string",
                "minLength": 1
              },
              "noteIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "vocalUnits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "unitId",
              "language",
              "syllables"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "language": {
                "type": "string",
                "minLength": 2,
                "maxLength": 128,
                "pattern": "^(?:[A-Za-z]{2,3}(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-[A-Za-z0-9]{5,8}|-[0-9][A-Za-z0-9]{3})*|und|mul)(?:-x(?:-[A-Za-z0-9]{1,8})+)?$"
              },
              "text": {
                "type": "string"
              },
              "pronunciation": {
                "type": "string"
              },
              "assignments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "index",
                    "noteIds"
                  ],
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "noteIds": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "additionalProperties": true
                }
              },
              "unitId": {
                "type": "string",
                "minLength": 1
              },
              "vocalText": {
                "type": "string",
                "minLength": 1
              },
              "syllables": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "indexUnit": {
          "const": "unicodeCodePoint",
          "description": "When present, all lyrics character offsets (not ticks) are zero-based Unicode scalar-value indices, end exclusive; excludes UTF-8 bytes, UTF-16 code units and grapheme clusters."
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
